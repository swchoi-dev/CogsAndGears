{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "unity@unity-agent-plugin": false
  },
  "permissions": {
    "deny": [
      "Edit(/CogsandGears/**)",
      "Write(/CogsandGears/**)",
      "Edit(**/*.cs)",
      "Write(**/*.cs)",
      "Edit(**/*.unity)",
      "Write(**/*.unity)",
      "Edit(**/*.prefab)",
      "Write(**/*.prefab)",
      "Edit(**/*.asset)",
      "Write(**/*.asset)",
      "Edit(**/*.mat)",
      "Write(**/*.mat)",
      "Edit(**/*.meta)",
      "Write(**/*.meta)",
      "mcp__unity",
      "mcp__unityMCP",
      "mcp__UnityMCP",
      "mcp__unity-mcp",
      "Bash(unity:*)",
      "PowerShell(unity:*)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push -f:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(git clean:*)",
      "PowerShell(git clean:*)",
      "Bash(git merge:*)",
      "PowerShell(git merge:*)",
      "Bash(git rebase:*)",
      "PowerShell(git rebase:*)",
      "Bash(gh pr merge:*)",
      "PowerShell(gh pr merge:*)",
      "Bash(gh issue delete:*)",
      "PowerShell(gh issue delete:*)",
      "Bash(gh repo delete:*)",
      "PowerShell(gh repo delete:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "PowerShell(git add:*)",
      "Bash(git commit:*)",
      "PowerShell(git commit:*)",
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(git checkout:*)",
      "PowerShell(git checkout:*)",
      "Bash(git switch:*)",
      "PowerShell(git switch:*)",
      "Bash(git restore:*)",
      "PowerShell(git restore:*)",
      "Bash(git reset:*)",
      "PowerShell(git reset:*)",
      "Bash(git rm:*)",
      "PowerShell(git rm:*)",
      "Bash(git mv:*)",
      "PowerShell(git mv:*)",
      "Bash(git stash:*)",
      "PowerShell(git stash:*)",
      "Bash(git branch -d:*)",
      "PowerShell(git branch -d:*)",
      "Bash(git branch -D:*)",
      "PowerShell(git branch -D:*)",
      "Bash(git branch -m:*)",
      "PowerShell(git branch -m:*)",
      "Bash(git tag:*)",
      "PowerShell(git tag:*)",
      "Bash(git cherry-pick:*)",
      "PowerShell(git cherry-pick:*)",
      "Bash(git revert:*)",
      "PowerShell(git revert:*)",
      "Bash(gh issue create:*)",
      "PowerShell(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "PowerShell(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "PowerShell(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "PowerShell(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "PowerShell(gh issue reopen:*)",
      "Bash(gh issue transfer:*)",
      "PowerShell(gh issue transfer:*)",
      "Bash(gh issue lock:*)",
      "PowerShell(gh issue lock:*)",
      "Bash(gh issue pin:*)",
      "PowerShell(gh issue pin:*)",
      "Bash(gh issue develop:*)",
      "PowerShell(gh issue develop:*)",
      "Bash(gh label create:*)",
      "PowerShell(gh label create:*)",
      "Bash(gh label edit:*)",
      "PowerShell(gh label edit:*)",
      "Bash(gh label delete:*)",
      "PowerShell(gh label delete:*)",
      "Bash(gh pr create:*)",
      "PowerShell(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "PowerShell(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "PowerShell(gh pr comment:*)",
      "Bash(gh pr close:*)",
      "PowerShell(gh pr close:*)",
      "Bash(gh pr review:*)",
      "PowerShell(gh pr review:*)",
      "Bash(gh pr checkout:*)",
      "PowerShell(gh pr checkout:*)",
      "Bash(gh release:*)",
      "PowerShell(gh release:*)",
      "Bash(gh workflow:*)",
      "PowerShell(gh workflow:*)",
      "Bash(gh secret:*)",
      "PowerShell(gh secret:*)",
      "Bash(gh variable:*)",
      "PowerShell(gh variable:*)",
      "Bash(gh repo edit:*)",
      "PowerShell(gh repo edit:*)",
      "Bash(gh api -X:*)",
      "PowerShell(gh api -X:*)",
      "Bash(gh api --method:*)",
      "PowerShell(gh api --method:*)"
    ]
  }
}
